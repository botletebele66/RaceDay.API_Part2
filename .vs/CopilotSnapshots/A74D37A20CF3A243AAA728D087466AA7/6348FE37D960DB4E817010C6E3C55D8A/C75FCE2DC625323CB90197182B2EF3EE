using System.ComponentModel.DataAnnotations;

namespace RaceDay.API_Part2.DTOs;

/// <summary>Body for POST /api/events. Categories are optional and can also be added later.</summary>
public class CreateEventRequest
{
    /// <summary>Event name.</summary>
    [Required, StringLength(255)]
    public string EventName { get; set; } = string.Empty;

    /// <summary>Start date and time. Must be in the future. Send an offset such as +02:00 or Z.</summary>
    [Required]
    public DateTime EventDate { get; set; }

    /// <summary>Venue or route description.</summary>
    [Required, StringLength(255)]
    public string Location { get; set; } = string.Empty;

    /// <summary>"Running", "Walking" or "Cycling".</summary>
    [Required, RegularExpression("^(Running|Walking|Cycling)$", ErrorMessage = "EventType must be Running, Walking or Cycling.")]
    public string EventType { get; set; } = string.Empty;

    /// <summary>Optional description (up to 4000 characters).</summary>
    [StringLength(4000)]
    public string? Description { get; set; }

    /// <summary>Optional capacity. Each enrolment uses one place.</summary>
    [Range(1, 100000)]
    public int? MaxParticipants { get; set; }

    /// <summary>Optional categories to create with the event.</summary>
    public List<CategoryRequest> Categories { get; set; } = new();
}

/// <summary>Body for PUT /api/events/{id}. Categories are managed through the category endpoints.</summary>
public class UpdateEventRequest
{
    /// <summary>Event name.</summary>
    [Required, StringLength(255)]
    public string EventName { get; set; } = string.Empty;

    /// <summary>Start date and time. A new date must be in the future.</summary>
    [Required]
    public DateTime EventDate { get; set; }

    /// <summary>Venue or route description.</summary>
    [Required, StringLength(255)]
    public string Location { get; set; } = string.Empty;

    /// <summary>"Running", "Walking" or "Cycling".</summary>
    [Required, RegularExpression("^(Running|Walking|Cycling)$", ErrorMessage = "EventType must be Running, Walking or Cycling.")]
    public string EventType { get; set; } = string.Empty;

    /// <summary>Optional description (up to 4000 characters).</summary>
    [StringLength(4000)]
    public string? Description { get; set; }

    /// <summary>Optional capacity. Cannot be lower than the number of active enrolments.</summary>
    [Range(1, 100000)]
    public int? MaxParticipants { get; set; }
}

/// <summary>Body for adding or updating a category (for example "Under 20" or "10km").</summary>
public class CategoryRequest
{
    /// <summary>Category label, unique within the event.</summary>
    [Required, StringLength(100)]
    public string CategoryName { get; set; } = string.Empty;

    /// <summary>Distance in kilometres (greater than 0).</summary>
    [Range(0.01, 1000)]
    public decimal Distance { get; set; }

    /// <summary>Entry fee in ZAR (0 or more).</summary>
    [Range(0, 100000)]
    public decimal EntryFee { get; set; }

    /// <summary>Optional minimum age on the event date.</summary>
    [Range(0, 120)]
    public int? AgeRestriction { get; set; }
}

/// <summary>A category belonging to an event.</summary>
public record CategoryResponse(int CategoryId, int EventId, string CategoryName, decimal Distance, decimal EntryFee, int? AgeRestriction);

/// <summary>An event with its categories.</summary>
public record EventResponse(
    int EventId,
    string EventName,
    DateTime EventDate,
    string Location,
    string EventType,
    string? Description,
    int? MaxParticipants,
    List<CategoryResponse> Categories);
