@host = http://localhost:5299

### Register an Organiser (needs the invite code configured in appsettings.Development.json)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Organiser",
  "email": "jane.organiser@example.com",
  "password": "Secret123",
  "role": "Organiser",
  "organiserInviteCode": "RACEDAY-ORG-2026",
  "companyName": "Durban Road Club",
  "registrationNumber": "REG-900"
}

### Log in (the session cookie is kept by the HTTP client)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "org1@raceday.co.za",
  "password": "Password123!"
}

### Public: list events
GET {{host}}/api/events

### Organiser: create an event with a category
POST {{host}}/api/events
Content-Type: application/json

{
  "eventName": "Durban Fun Run",
  "eventDate": "2027-03-01T06:00:00+02:00",
  "location": "Durban beachfront",
  "eventType": "Running",
  "description": "A friendly 10km run.",
  "maxParticipants": 300,
  "categories": [
    { "categoryName": "10km", "distance": 10, "entryFee": 150, "ageRestriction": null }
  ]
}

### Participant: enrol in category 4 (log in as participant1@example.com first)
POST {{host}}/api/enrolments
Content-Type: application/json

{
  "categoryId": 4
}

### Participant: list my enrolments
GET {{host}}/api/enrolments

### Log out
POST {{host}}/api/auth/logout
