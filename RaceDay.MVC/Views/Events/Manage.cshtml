@model EventManageViewModel
@{
    var ev = Model.Event;
    var local = SouthAfricaTime.FromApi(ev.EventDate);
    ViewData["Title"] = "Manage " + ev.EventName;
    var active = Model.Enrolments.Count(e => e.Status != "Withdrawn");
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb rd-crumbs">
        <li class="breadcrumb-item"><a asp-controller="Events" asp-action="Index">My events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ev.EventName</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-panel p-0 overflow-hidden">
            <div class="rd-detail-media rd-detail-media-sm"><partial name="_EventBanner" model="ev" /></div>
            <div class="p-4">
                <span class="rd-badge @UiFormat.EventTypeClass(ev.EventType) mb-2">@ev.EventType</span>
                <h1 class="rd-title h3">@ev.EventName</h1>
                <ul class="list-unstyled small rd-facts mb-4">
                    <li class="mb-1"><i class="fa-regular fa-calendar me-2" aria-hidden="true"></i>@UiFormat.LongDate(local) at @UiFormat.ShortTime(local)</li>
                    <li><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@ev.Location</li>
                </ul>
                <div class="d-grid gap-2">
                    <a class="btn btn-rd-primary" asp-controller="Events" asp-action="Edit" asp-route-id="@ev.EventId">Edit event details</a>
                    <a class="btn btn-rd-dark" asp-controller="Enrolments" asp-action="Event" asp-route-id="@ev.EventId">Participants (@active)</a>
                    <a class="btn btn-rd-ghost" asp-controller="Results" asp-action="Event" asp-route-id="@ev.EventId">Enter results</a>
                    <a class="btn btn-rd-ghost" asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventId">View public page</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <section class="rd-panel mb-4" aria-labelledby="catHeading">
            <h2 id="catHeading" class="h5 mb-3">Categories</h2>
            @if (!ev.Categories.Any())
            {
                <p class="rd-muted">No categories yet. Add at least one so participants can enrol.</p>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th scope="col">Category</th><th scope="col">Distance</th><th scope="col">Entry fee</th><th scope="col">Min. age</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var category in ev.Categories)
                            {
                                <tr>
                                    <td class="fw-semibold">@category.CategoryName</td>
                                    <td>@UiFormat.Km(category.Distance)</td>
                                    <td>@UiFormat.Money(category.EntryFee)</td>
                                    <td>@(category.AgeRestriction?.ToString() ?? "Any")</td>
                                    <td class="text-end">
                                        <form asp-controller="Events" asp-action="DeleteCategory" method="post" class="d-inline" data-confirm="Remove this category?">
                                            <input type="hidden" name="eventId" value="@ev.EventId" />
                                            <input type="hidden" name="categoryId" value="@category.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <form asp-controller="Events" asp-action="AddCategory" method="post" class="rd-add-category row g-2 align-items-end">
                <input type="hidden" name="eventId" value="@ev.EventId" />
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold" for="newCategoryName">New category</label>
                    <input id="newCategoryName" class="form-control" name="category.CategoryName" maxlength="100" required placeholder="e.g. 5km Fun Run" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="newCategoryDistance">Distance (km)</label>
                    <input id="newCategoryDistance" class="form-control" type="number" step="0.01" min="0.01" name="category.Distance" value="10" required />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="newCategoryFee">Entry fee (R)</label>
                    <input id="newCategoryFee" class="form-control" type="number" step="0.01" min="0" name="category.EntryFee" value="0" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="newCategoryAge">Min. age</label>
                    <input id="newCategoryAge" class="form-control" type="number" min="0" max="120" name="category.AgeRestriction" placeholder="Any" />
                </div>
                <div class="col-6 col-md-2 d-grid">
                    <button type="submit" class="btn btn-rd-dark">Add</button>
                </div>
            </form>
        </section>

        <section class="rd-panel" aria-labelledby="recentHeading">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 id="recentHeading" class="h5 mb-0">Recent enrolments</h2>
                <a asp-controller="Enrolments" asp-action="Event" asp-route-id="@ev.EventId">See all</a>
            </div>
            @if (!Model.Enrolments.Any())
            {
                <p class="rd-muted mb-0">No participants yet. Share the event page to fill your places.</p>
            }
            else
            {
                <ul class="list-unstyled rd-list mb-0">
                    @foreach (var enrolment in Model.Enrolments.Take(6))
                    {
                        <li>
                            <div><span class="fw-semibold">@enrolment.FirstName @enrolment.LastName</span> <span class="small rd-muted">· @enrolment.CategoryName</span></div>
                            <partial name="_StatusBadge" model="enrolment.Status" />
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
