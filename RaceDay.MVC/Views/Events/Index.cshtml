@model OrganiserEventsViewModel
@{
    ViewData["Title"] = "My events";
}

<div class="rd-page-head d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="rd-title mb-1">My events</h1>
        <p class="rd-muted mb-0">Create, update and manage the events you organise.</p>
    </div>
    <a class="btn btn-rd-primary" asp-controller="Events" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Create event</a>
</div>

@if (!Model.Rows.Any())
{
    <div class="rd-empty text-center">
        <div class="rd-empty-icon"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i></div>
        <h2 class="h4">No events yet</h2>
        <p class="rd-muted">Create your first event, add distance categories and open entries.</p>
        <a class="btn btn-rd-primary" asp-controller="Events" asp-action="Create">Create your first event</a>
    </div>
}
else
{
    <div class="rd-panel p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Categories</th>
                        <th scope="col" class="text-end">Enrolments</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var ev = row.Event;
                        <tr>
                            <td>
                                <a class="fw-semibold" asp-controller="Events" asp-action="Manage" asp-route-id="@ev.EventId">@ev.EventName</a>
                                <div class="small rd-muted"><span class="rd-badge @UiFormat.EventTypeClass(ev.EventType)">@ev.EventType</span> @ev.Location</div>
                            </td>
                            <td class="small">@UiFormat.LongDate(SouthAfricaTime.FromApi(ev.EventDate))</td>
                            <td class="small">@ev.Categories.Count</td>
                            <td class="text-end fw-bold">@row.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-rd-ghost" asp-controller="Events" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a>
                                <a class="btn btn-sm btn-rd-dark" asp-controller="Events" asp-action="Manage" asp-route-id="@ev.EventId">Manage</a>
                                @if (row.EnrolmentCount == 0)
                                {
                                    <form asp-controller="Events" asp-action="Delete" asp-route-id="@ev.EventId" method="post" class="d-inline" data-confirm="Delete this event? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
