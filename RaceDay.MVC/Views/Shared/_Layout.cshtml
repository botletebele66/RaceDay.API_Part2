<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="RaceDay: organise, discover and enrol in road runs, walks and cycling events across South Africa." />
    <meta name="theme-color" content="#0A0E1A" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230A0E1A'/%3E%3Cpath d='M20 16v34M20 16h22l-6 8 6 8H20' stroke='%23C9F94A' stroke-width='5' fill='none' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <script>
        /* Apply the saved theme before first paint (light by default). */
        (function () {
            var theme = 'light';
            try { theme = localStorage.getItem('raceday_theme_v1') || 'light'; } catch (e) { theme = 'light'; }
            if (theme !== 'light' && theme !== 'dark') { theme = 'light'; }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <a class="skip-link" href="#main">Skip to content</a>

    <header>
        <nav class="navbar navbar-expand-lg rd-nav sticky-top" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <span class="rd-mark" aria-hidden="true"><i class="fa-solid fa-flag-checkered"></i></span>
                    <span>Race<span class="rd-brand-accent">Day</span></span>
                </a>
                <button class="navbar-toggler rd-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdMenu" aria-controls="rdMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="rdMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link@(currentController == "Home" ? " active" : "")" asp-controller="Home" asp-action="Index">Events</a></li>
                        @if (Me.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link@(currentController == "Dashboard" ? " active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            @if (Me.IsOrganiser)
                            {
                                <li class="nav-item"><a class="nav-link@(currentController == "Events" && currentAction != "Create" ? " active" : "")" asp-controller="Events" asp-action="Index">My events</a></li>
                                <li class="nav-item"><a class="nav-link@(currentAction == "Create" ? " active" : "")" asp-controller="Events" asp-action="Create">Create event</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link@(currentController == "Enrolments" ? " active" : "")" asp-controller="Enrolments" asp-action="Index">My events</a></li>
                                <li class="nav-item"><a class="nav-link@(currentController == "Results" ? " active" : "")" asp-controller="Results" asp-action="Index">My results</a></li>
                            }
                            <li class="nav-item"><a class="nav-link@(currentController == "Profile" ? " active" : "")" asp-controller="Profile" asp-action="Index">Profile</a></li>
                        }
                    </ul>

                    <div class="d-flex flex-wrap align-items-center gap-2 py-2 py-lg-0">
                        @if (Me.IsAuthenticated)
                        {
                            <span class="rd-user">
                                <span class="rd-avatar" aria-hidden="true">@Me.Initials</span>
                                <span class="rd-user-name">@Me.DisplayName</span>
                                <span class="rd-role">@(Me.IsOrganiser ? "Organiser" : "Participant")</span>
                            </span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-rd-ghost">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-rd-ghost" asp-controller="Auth" asp-action="Login">Sign in</a>
                            <a class="btn btn-sm btn-rd-primary" asp-controller="Auth" asp-action="Register">Join free</a>
                        }
                        <button class="rd-theme-toggle" type="button" id="rdThemeToggle" aria-label="Switch to dark mode">
                            <i class="fa-solid fa-moon" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="container rd-main">
        @if (TempData["Success"] is string success)
        {
            <div class="alert rd-alert rd-alert-success alert-dismissible fade show" role="status">
                <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert rd-alert rd-alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewData["Error"] is string viewError)
        {
            <div class="alert rd-alert rd-alert-danger" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@viewError
            </div>
        }

        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span><strong>RaceDay</strong> · Road running, walking and cycling events across South Africa</span>
            <span class="rd-muted small">Times shown in South Africa Standard Time (SAST)</span>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
