@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="rd-auth-split">
    <aside class="rd-auth-art" aria-hidden="true">
        <p class="rd-hero-pill"><span class="rd-pulse"></span> Welcome back</p>
        <h2>Your next<br /><span class="rd-accent">starting line</span><br />is waiting.</h2>
        <p>Sign in to manage events, track results, and chase your personal best.</p>
        <ul class="rd-auth-features">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i> Live enrolments and results</li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i> Multi-category events</li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i> Built for South African road sports</li>
        </ul>
    </aside>

    <div class="rd-auth-form">
        <h1 class="rd-title h2 mb-1">Welcome Back</h1>
        <p class="rd-muted mb-4">Sign in to continue.</p>

        <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    <button class="btn btn-outline-secondary" type="button" data-toggle-password="Password" aria-label="Show password">
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button class="btn btn-rd-primary btn-lg w-100" type="submit">Sign in</button>
        </form>


        <p class="text-center small mt-4 mb-0">New to RaceDay? <a asp-controller="Auth" asp-action="Register">Create an account</a></p>
    </div>
</div>

